@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "MyMovies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My Movies</h1>
    <a asp-action="Create" class="btn btn-success">+ Add Movie</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="Movies" asp-action="Index" method="get">
            <div class="row g-2 align-items-end">

                <div class="col-md-3">
                    <label asp-for="MovieGenre" class="form-label">Genre</label>
                    <select asp-for="MovieGenre" asp-items="Model.Genres" class="form-select">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="MovieYear" class="form-label">Year or newer</label>
                    <select asp-for="MovieYear" asp-items="Model.Years" class="form-select">
                        <option value="">All Years</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="SearchString" class="form-label">Title</label>
                    <input asp-for="SearchString" class="form-control" placeholder="Search by title..." />
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>

            </div>
        </form>
    </div>
</div>

<table class="table table-hover align-middle mb-0">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Movies![0].Title)</th>
            <th>@Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)</th>
            <th>@Html.DisplayNameFor(model => model.Movies![0].Genre)</th>
            <th>@Html.DisplayNameFor(model => model.Movies![0].Price)</th>
            <th>@Html.DisplayNameFor(model => model.Movies![0].Rating)</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Movies!)
        {
            <tr>
                <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@item.ReleaseDate.ToString("yyyy-MM-dd")</td>
                <td><span class="badge bg-secondary">@item.Genre</span></td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td><span class="badge bg-info text-dark">@item.Rating</span></td>
                <td class="text-end action-links">
                    <a asp-action="Edit"    asp-route-id="@item.Id" class="edit">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="details">Details</a>
                    <a asp-action="Delete"  asp-route-id="@item.Id" class="delete">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
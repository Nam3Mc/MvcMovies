@model MvcMovie.Models.Movie

@{
    ViewData["Title"] = "Delete";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0 text-danger">Delete Movie</h1>
    <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white fw-semibold">
                ⚠️ Are you sure you want to delete this movie?
            </div>
            <div class="card-body">

                <p class="text-muted mb-4">
                    This action cannot be undone. The movie below will be permanently removed.
                </p>

                <dl class="row mb-4">
                    <dt class="col-sm-3">Title</dt>
                    <dd class="col-sm-9 fw-semibold">@Model?.Title</dd>

                    <dt class="col-sm-3">Release Date</dt>
                    <dd class="col-sm-9">@Model?.ReleaseDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3">Genre</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary">@Model?.Genre</span>
                    </dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@Model?.Price.ToString("C")</dd>

                    <dt class="col-sm-3">Rating</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-info text-dark">@Model?.Rating</span>
                    </dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Yes, delete this movie</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>